# Copy secrets into apps/api/.env
# Public Vite keys can also go in apps/web/.env
# Never put real keys in this file.

NODE_ENV=development
PORT=3005
CLIENT_ORIGIN=http://localhost:5173

# Supabase → Project Settings → Database → Connection string
# Prefer "Session pooler" (port 5432, host …pooler.supabase.com, user postgres.PROJECT_REF).
# Direct (db.PROJECT_REF.supabase.co) often causes ECONNRESET / pool timeouts in Sequelize.
# Never use the Transaction pooler (port 6543) with Sequelize.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary → Dashboard → API Keys (API only; never expose to the web app)
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

REDIS_URL=redis://localhost:6379
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=teakflow-dev-master-key

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=3h
JWT_REFRESH_EXPIRES_IN=31d

COMPANY_TIMEZONE=Asia/Kolkata

# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Needed only for creating Google Meet links (Phase 4). Leave blank until then.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3005/api/v1/auth/google/callback

# Yaadro yearly payment workbook (see docs/SALES_DRIVE.md)
GOOGLE_SALES_SA_JSON=
GOOGLE_SALES_FOLDER_ID=
GOOGLE_SALES_SPREADSHEET_IDS=

VITE_API_URL=http://localhost:3005/api/v1
VITE_SOCKET_URL=http://localhost:3005
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
